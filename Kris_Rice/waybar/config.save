{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,
    "modules-left": ["custom/launcher", "sway/workspaces", "sway/window"],
    "modules-center": ["clock"],
    "modules-right": ["bluetooth", "pulseaudio", "tray"],

    "custom/launcher": {
        "format": " ",
        "on-click": "wofi --show drun",
        "tooltip": false
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "あ",
            "2": "い",
            "3": "う",
            "4": "え",
            "5": "お",
            "default": ""
        }
    },
    "sway/window": {
        "format": "{title}",
        "max-length": 45
    },
    "clock": {
        "format": "  {:%H:%M     %a, %d %b}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "bluetooth": {
        "format": "",
        "format-connected": " {device_alias}",
        "on-click": "blueman-manager"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": " {icon}  {volume}%",
        "format-muted": "  Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "tray": {
        "spacing": 10
    }
}
